{
    "name": "ekagent/logviewer",
    "description": "Read-only access to Laravel application log files",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "laravel/framework": "^13.0",
        "nwidart/laravel-modules": "^13.0",
        "spatie/laravel-permission": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "Modules\\LogViewer\\": "app/",
            "Modules\\LogViewer\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Modules\\LogViewer\\Tests\\": "tests/"
        }
    }
}
